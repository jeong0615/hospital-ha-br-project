[Unit]
Description=Hospital DR environment lifecycle tied to the local controller
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=cloud
Environment=DR_REPO_ROOT=/home/cloud/hospital-dr-codex
Environment=DR_TERRAFORM_DIR=/home/cloud/hospital-dr-terraform
Environment=DR_OPERATIONS_DIR=/home/cloud/hospital-dr-codex/operations
Environment=DR_SECRET_FILE=/home/cloud/hospital-dr-secrets/dr.env
StateDirectory=hospital-dr
StateDirectoryMode=0750
WorkingDirectory=/home/cloud/hospital-dr-codex
RemainAfterExit=yes
ExecStart=/home/cloud/hospital-dr-codex/operations/finops/dr_environment_control.sh start
ExecStop=/home/cloud/hospital-dr-codex/operations/finops/dr_environment_control.sh stop
TimeoutStartSec=20min
TimeoutStopSec=20min
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
