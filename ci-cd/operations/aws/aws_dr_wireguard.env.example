# Dedicated AWS DR WireGuard path. Disabled until a reviewed live window.
AWS_DR_WG_ENABLED=false
# Terraform consumes the same switch through TF_VAR_aws_dr_wg_enabled.
# Keep both disabled unless the reviewed live window is active.
TF_VAR_aws_dr_wg_enabled=false
AWS_DR_WG_ROLE=gateway
AWS_DR_WG_INTERFACE=wg-aws-dr
AWS_DR_WG_CIDR=10.251.0.0/24
AWS_DR_WG_GATEWAY_ADDRESS=10.251.0.1/24
AWS_DR_WG_PEER_ADDRESS=10.251.0.2
AWS_DR_WG_AWS_DB_IP=10.20.30.10
AWS_DR_WG_ENDPOINT=52.79.244.146:51821
AWS_DR_WG_PORT=51821
AWS_DR_WG_PEER_INGRESS_CIDR=1.209.148.228/32

# Key files are provisioned out-of-band and must never be committed.
AWS_DR_WG_WEB_PRIVATE_KEY_FILE=/etc/hospital-dr/wireguard/aws-dr-web.key
AWS_DR_WG_ONPREM_PRIVATE_KEY_FILE=/etc/hospital-dr/wireguard/aws-dr-onprem.key
AWS_DR_WG_WEB_PUBLIC_KEY_FILE=/etc/hospital-dr/wireguard/aws-dr-web.pub
AWS_DR_WG_ONPREM_PUBLIC_KEY_FILE=/etc/hospital-dr/wireguard/aws-dr-onprem.pub
