#!/usr/bin/env bash
set -euo pipefail

# This controller owns only the two named chains below. It never flushes the
# global filter/nat tables and never edits Docker or WireGuard chains.
IPTABLES_BIN="${IPTABLES_BIN:-/usr/sbin/iptables}"
UPLINK="{{ aws_web_nat_instance_uplink_interface }}"
FORWARD_CHAIN="{{ aws_web_nat_instance_forward_chain }}"
POSTROUTING_CHAIN="{{ aws_web_nat_instance_postrouting_chain }}"
WG_INTERFACE="{{ aws_web_nat_instance_interface }}"

private_cidrs=(
{% for cidr in aws_web_nat_instance_private_cidrs %}
  "{{ cidr }}"
{% endfor %}
)
excluded_destinations=(
{% for cidr in aws_web_nat_instance_excluded_destinations %}
  "{{ cidr }}"
{% endfor %}
)

iptables_cmd() {
  "$IPTABLES_BIN" -w "$@"
}

iptables_nat_cmd() {
  "$IPTABLES_BIN" -w -t nat "$@"
}

chain_exists() {
  iptables_cmd -S "$1" >/dev/null 2>&1
}

nat_chain_exists() {
  iptables_nat_cmd -S "$1" >/dev/null 2>&1
}

remove_jump() {
  local table="$1"
  local chain="$2"
  while true; do
    if [ "$table" = nat ]; then
      iptables_nat_cmd -C POSTROUTING -j "$chain" >/dev/null 2>&1 || break
      iptables_nat_cmd -D POSTROUTING -j "$chain"
    else
      iptables_cmd -C FORWARD -j "$chain" >/dev/null 2>&1 || break
      iptables_cmd -D FORWARD -j "$chain"
    fi
  done
}

remove_owned_chains() {
  remove_jump filter "$FORWARD_CHAIN"
  remove_jump nat "$POSTROUTING_CHAIN"
  if chain_exists "$FORWARD_CHAIN"; then
    iptables_cmd -F "$FORWARD_CHAIN"
    iptables_cmd -X "$FORWARD_CHAIN"
  fi
  if nat_chain_exists "$POSTROUTING_CHAIN"; then
    iptables_nat_cmd -F "$POSTROUTING_CHAIN"
    iptables_nat_cmd -X "$POSTROUTING_CHAIN"
  fi
}

apply_owned_chains() {
  # Rebuild only our private chains, so repeated runs stay idempotent while
  # Docker and wg-aws-dr rules remain intact.
  remove_owned_chains
  iptables_cmd -N "$FORWARD_CHAIN"
  iptables_nat_cmd -N "$POSTROUTING_CHAIN"

  iptables_cmd -A "$FORWARD_CHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  for excluded in "${excluded_destinations[@]}"; do
    iptables_cmd -A "$FORWARD_CHAIN" -d "$excluded" -j RETURN
  done
  for cidr in "${private_cidrs[@]}"; do
    iptables_cmd -A "$FORWARD_CHAIN" -s "$cidr" -o "$UPLINK" -j ACCEPT
  done

  for excluded in "${excluded_destinations[@]}"; do
    iptables_nat_cmd -A "$POSTROUTING_CHAIN" -d "$excluded" -j RETURN
  done
  for cidr in "${private_cidrs[@]}"; do
    iptables_nat_cmd -A "$POSTROUTING_CHAIN" -s "$cidr" -o "$UPLINK" -j MASQUERADE
  done

  iptables_cmd -I FORWARD 1 -j "$FORWARD_CHAIN"
  iptables_nat_cmd -I POSTROUTING 1 -j "$POSTROUTING_CHAIN"
}

case "${1:-status}" in
  apply)
    apply_owned_chains
    ;;
  remove)
    remove_owned_chains
    ;;
  status)
    chain_exists "$FORWARD_CHAIN" && echo "FORWARD_CHAIN=present" || echo "FORWARD_CHAIN=absent"
    nat_chain_exists "$POSTROUTING_CHAIN" && echo "POSTROUTING_CHAIN=present" || echo "POSTROUTING_CHAIN=absent"
    echo "UPLINK=$UPLINK"
    echo "WG_INTERFACE=$WG_INTERFACE"
    ;;
  *)
    echo "Usage: $0 {apply|remove|status}" >&2
    exit 2
    ;;
esac
